# Large Binaries (> 100 MB rejected by GitHub without LFS)
Builds/*.apk
Builds/*.aab
Datasets/*.zip

# Node / Web Frontend
**/node_modules/
**/dist/
.npm/
*.log

# Dart / Flutter
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/build/
.pub-cache/
.pub/

# Python
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
venv/
.venv/
env/

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Nested git backups
.git_backup/
**/.git_backup/
